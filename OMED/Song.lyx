// OMED/Song.lyx — Song, Block, Instrument, Sequence.
//
// Die Begriffe sind die von OctaMED und werden nicht modernisiert: ein Song
// besteht aus Blocks, ein Block aus Lines und Tracks, in einer Zelle stehen
// Note, Instrument und Command. Kein Clip, kein Pattern, keine Lane.
//
// Zellformat wie MMD1 — vier Bytes, hier in einem int64 gepackt, weil eine
// Zelle damit atomar kopierbar bleibt (Block-Operationen in spaeteren Phasen):
//
//   Bit  0..7   Note        0 = ---, 1 = C-1, 2 = C#1, ...
//   Bit  8..15  Instrument  0 = kein Wechsel, 1..3F
//   Bit 16..23  Command     00..2F
//   Bit 24..31  Level       00..FF (Datenbyte des Commands)
//
// Ein Block traegt seine Track- und Line-Zahl SELBST. Das ist kein Detail:
// bei ProTracker sind 64 Zeilen global, bei OctaMED entscheidet das jeder
// Block fuer sich, und darauf bauen Song-Sequence und Blockliste auf.

@description("OctaMED-Tracker - Songdaten")
@author("Andreas Roene")
unit OMED.Song;

import Vega.Types;
import Vega.Lists;
import Vega.Strings;

pub con OM_MAX_TRACKS: int64 := 16;    // MMD trkvol[16]
pub con OM_MAX_LINES: int64 := 3200;   // MMD1-Blockgrenze
pub con OM_MAX_INSTR: int64 := 63;     // MMD: 63 Samples
pub con OM_MAX_SEQ: int64 := 256;      // MMD0song.playseq[256]

// ---- Zelle: packen und auslesen --------------------------------------------
pub fn CellPack(note: int64, instr: int64, cmd: int64, level: int64): int64 {
  return (note & 0xFF) | ((instr & 0xFF) << 8) | ((cmd & 0xFF) << 16)
       | ((level & 0xFF) << 24);
}

pub fn CellNote(c: int64): int64 { return c & 0xFF; }
pub fn CellInstr(c: int64): int64 { return (c >> 8) & 0xFF; }
pub fn CellCmd(c: int64): int64 { return (c >> 16) & 0xFF; }
pub fn CellLevel(c: int64): int64 { return (c >> 24) & 0xFF; }

// ---- Notennamen ------------------------------------------------------------
// Zwei Zeichen je Halbton, damit jeder Notenname genau drei Zeichen breit ist
// ("C-3", "C#3"). Ein "C" allein wuerde die Spalte verschieben, und im
// Tracker haengt daran die ganze Lesbarkeit.
fn SemitoneName(st: int64): pchar {
  if (st == 0) { return "C-"; }
  if (st == 1) { return "C#"; }
  if (st == 2) { return "D-"; }
  if (st == 3) { return "D#"; }
  if (st == 4) { return "E-"; }
  if (st == 5) { return "F-"; }
  if (st == 6) { return "F#"; }
  if (st == 7) { return "G-"; }
  if (st == 8) { return "G#"; }
  if (st == 9) { return "A-"; }
  if (st == 10) { return "A#"; }
  return "B-";
}

pub fn NoteSemitone(note: int64): int64 { return (note - 1) % 12; }
pub fn NoteOctave(note: int64): int64 { return ((note - 1) / 12) + 1; }

pub fn HexDigit(v: int64): int64 {
  var d: int64 := v & 0xF;
  if (d < 10) { return 48 + d; }        // '0'
  return 65 + (d - 10);                 // 'A'
}

// ---- Instrument ------------------------------------------------------------
// Die Felder sind die der MMD-Instrumentstruktur, damit der MMD-Import in
// Phase 10 nichts umrechnen muss ausser rep/replen (dort >>1 gespeichert).
pub type TInstrument = class {
  Name: pchar;
  Volume: int64;        // svol, 0..64
  Transpose: int64;     // strans
  FineTune: int64;      // -8..+7
  RepeatStart: int64;   // rep, in Worten
  RepeatLen: int64;     // replen, in Worten
  Hold: int64;
  Decay: int64;
  MidiChannel: int64;   // midich, 0 = kein MIDI
  MidiPreset: int64;    // midipreset
  SampleData: int64;    // Zeiger auf 8-Bit-Sampledaten (signed), 0 = leer
  SampleLen: int64;
  SampleRate: int64;    // Aufnahmerate aus dem 8SVX-Header, 0 = unbekannt

  fn Create(): void {
    self.Name := "";
    self.Volume := 64;
    self.Transpose := 0;
    self.FineTune := 0;
    self.RepeatStart := 0;
    self.RepeatLen := 0;
    self.Hold := 0;
    self.Decay := 0;
    self.MidiChannel := 0;
    self.MidiPreset := 0;
    self.SampleData := 0;
    self.SampleLen := 0;
    self.SampleRate := 0;
  }

  fn IsEmpty(): bool {
    if (self.SampleData != 0) { return false; }
    if (self.MidiChannel != 0) { return false; }
    return PCharLen(self.Name) == 0;
  }
}

pub fn NewInstrument(name: pchar): TInstrument {
  var i: TInstrument := new TInstrument();
  i.Name := name;
  return i;
}

// ---- Block -----------------------------------------------------------------
pub type TBlock = class {
  Name: pchar;
  Tracks: int64;
  Lines: int64;
  Cells: TIntArray;

  fn Create(tracks: int64, lines: int64): void {
    var t: int64 := tracks;
    var l: int64 := lines;
    if (t < 1) { t := 1; }
    if (t > OM_MAX_TRACKS) { t := OM_MAX_TRACKS; }
    if (l < 1) { l := 1; }
    if (l > OM_MAX_LINES) { l := OM_MAX_LINES; }
    self.Name := "";
    self.Tracks := t;
    self.Lines := l;
    self.Cells := new TIntArray(t * l);
  }

  fn Destroy(): void {
    if (self.Cells != null) { self.Cells.Destroy(); }
  }

  fn CellIndex(line: int64, track: int64): int64 {
    return (line * self.Tracks) + track;
  }

  // Ausserhalb des Blocks liefert Get eine leere Zelle und Put tut nichts —
  // ein Cursor, der einen Schritt zu weit gelaufen ist, soll nicht in einen
  // Speicherzugriff ausarten.
  fn Cell(line: int64, track: int64): int64 {
    if (line < 0) { return 0; }
    if (line >= self.Lines) { return 0; }
    if (track < 0) { return 0; }
    if (track >= self.Tracks) { return 0; }
    return self.Cells.Get(self.CellIndex(line, track));
  }

  fn PutCell(line: int64, track: int64, value: int64): void {
    if (line < 0) { return; }
    if (line >= self.Lines) { return; }
    if (track < 0) { return; }
    if (track >= self.Tracks) { return; }
    self.Cells.Put(self.CellIndex(line, track), value);
  }

  fn ClearCell(line: int64, track: int64): void {
    self.PutCell(line, track, 0);
  }

  // Blockmasse aendern (Block Properties). Der Inhalt bleibt erhalten, soweit
  // er in die neuen Masse passt — wer einen Block verkleinert, verliert genau
  // das, was er abschneidet, und nicht mehr.
  fn Resize(tracks: int64, lines: int64): void {
    var t: int64 := tracks;
    var l: int64 := lines;
    if (t < 1) { t := 1; }
    if (t > OM_MAX_TRACKS) { t := OM_MAX_TRACKS; }
    if (l < 1) { l := 1; }
    if (l > OM_MAX_LINES) { l := OM_MAX_LINES; }
    if (t == self.Tracks) {
      if (l == self.Lines) { return; }
    }

    var fresh: TIntArray := new TIntArray(t * l);
    var line: int64 := 0;
    while (line < l) {
      var track: int64 := 0;
      while (track < t) {
        if (line < self.Lines) {
          if (track < self.Tracks) {
            fresh.Put((line * t) + track, self.Cell(line, track));
          }
        }
        track := track + 1;
      }
      line := line + 1;
    }

    if (self.Cells != null) { self.Cells.Destroy(); }
    self.Cells := fresh;
    self.Tracks := t;
    self.Lines := l;
  }

  // Line einfuegen: ab der Einfuegestelle rutscht alles eine Line nach unten,
  // die letzte Line faellt aus dem Block. Die Blocklaenge bleibt, wie sie ist
  // — sie zu aendern ist in OctaMED eine Sache der Block Properties und nicht
  // ein Nebeneffekt der Eingabe.
  fn InsertLine(line: int64): void {
    if (line < 0) { return; }
    if (line >= self.Lines) { return; }
    var l: int64 := self.Lines - 1;
    while (l > line) {
      var t: int64 := 0;
      while (t < self.Tracks) {
        self.Cells.Put(self.CellIndex(l, t), self.Cells.Get(self.CellIndex(l - 1, t)));
        t := t + 1;
      }
      l := l - 1;
    }
    var t2: int64 := 0;
    while (t2 < self.Tracks) {
      self.Cells.Put(self.CellIndex(line, t2), 0);
      t2 := t2 + 1;
    }
  }

  // Line loeschen: alles darunter rueckt eine Line hoch, unten kommt eine
  // leere Line nach.
  fn DeleteLine(line: int64): void {
    if (line < 0) { return; }
    if (line >= self.Lines) { return; }
    var l: int64 := line;
    while (l < self.Lines - 1) {
      var t: int64 := 0;
      while (t < self.Tracks) {
        self.Cells.Put(self.CellIndex(l, t), self.Cells.Get(self.CellIndex(l + 1, t)));
        t := t + 1;
      }
      l := l + 1;
    }
    var t2: int64 := 0;
    while (t2 < self.Tracks) {
      self.Cells.Put(self.CellIndex(self.Lines - 1, t2), 0);
      t2 := t2 + 1;
    }
  }
}

pub fn NewBlock(tracks: int64, lines: int64): TBlock {
  return new TBlock(tracks, lines);
}

// ---- Playing Sequence ------------------------------------------------------
// Eine geordnete Liste von Blocknummern. Ein Block darf mehrfach vorkommen —
// genau dafuer gibt es die Sequence: der Block ist das Material, die Sequence
// die Form.
//
// Ab V5 gibt es MEHRERE davon (Sections), und darueber eine Sektionsliste.
// Deshalb ist das hier eine eigene Klasse und kein Array im Song: sonst
// muesste jede Stelle, die die Sequence anfasst, wissen, welche gerade gilt.
pub type TPlaySeq = class {
  Name: pchar;
  Entries: TIntArray;
  Len: int64;

  fn Create(name: pchar): void {
    self.Name := name;
    self.Entries := new TIntArray(OM_MAX_SEQ);
    self.Len := 0;
  }

  fn Destroy(): void {
    if (self.Entries != null) { self.Entries.Destroy(); }
  }

  fn Get(i: int64): int64 {
    if (i < 0) { return 0; }
    if (i >= self.Len) { return 0; }
    return self.Entries.Get(i);
  }

  fn Put(i: int64, blockNo: int64): void {
    if (i < 0) { return; }
    if (i >= self.Len) { return; }
    self.Entries.Put(i, blockNo);
  }

  fn Add(blockNo: int64): void {
    if (self.Len >= OM_MAX_SEQ) { return; }
    self.Entries.Put(self.Len, blockNo);
    self.Len := self.Len + 1;
  }

  fn Insert(pos: int64, blockNo: int64): void {
    if (self.Len >= OM_MAX_SEQ) { return; }
    var p: int64 := pos;
    if (p < 0) { p := 0; }
    if (p > self.Len) { p := self.Len; }
    var i: int64 := self.Len;
    while (i > p) {
      self.Entries.Put(i, self.Entries.Get(i - 1));
      i := i - 1;
    }
    self.Entries.Put(p, blockNo);
    self.Len := self.Len + 1;
  }

  fn Remove(pos: int64): void {
    if (pos < 0) { return; }
    if (pos >= self.Len) { return; }
    var i: int64 := pos;
    while (i < self.Len - 1) {
      self.Entries.Put(i, self.Entries.Get(i + 1));
      i := i + 1;
    }
    self.Len := self.Len - 1;
  }

  // Zwei Eintraege tauschen — das ist Verschieben, wenn der Nachbar gemeint
  // ist, und braucht keine eigene Umschichtung.
  fn Swap(a: int64, b: int64): void {
    if (a < 0) { return; }
    if (b < 0) { return; }
    if (a >= self.Len) { return; }
    if (b >= self.Len) { return; }
    var t: int64 := self.Entries.Get(a);
    self.Entries.Put(a, self.Entries.Get(b));
    self.Entries.Put(b, t);
  }
}

pub fn NewPlaySeq(name: pchar): TPlaySeq {
  return new TPlaySeq(name);
}

// ---- Song ------------------------------------------------------------------
// Tempo: deftempo ist der Tempo-Slider bzw. BPM, wenn BpmMode gesetzt ist;
// Tpl ist tempo2, die Zahl der Ticks pro Line. Beides getrennt gefuehrt, weil
// OctaMED beides getrennt fuehrt — ein einzelner "Tempo"-Wert waere schon die
// erste Modernisierung.
pub type TSong = class {
  Name: pchar;
  Blocks: TObjectList;
  BlockCount: int64;
  Instruments: TObjectList;
  InstrCount: int64;
  Sections: TObjectList;  // TPlaySeq je Section (V5)
  SectionCount: int64;
  CurSection: int64;      // die Sequence, die gespielt und gezeigt wird
  Tempo: int64;           // deftempo
  Tpl: int64;             // tempo2, Ticks pro Line
  Lpb: int64;             // Lines je Beat (FLAG2_BMASK, 1..32)
  MasterVolume: int64;
  HexVolumes: bool;       // FLAG_VOLHEX
  BpmMode: bool;          // FLAG2_BPM
  EightChannel: bool;     // FLAG_8CHANNEL

  fn Create(name: pchar): void {
    self.Name := name;
    self.Blocks := new TObjectList();
    self.BlockCount := 0;
    self.Instruments := new TObjectList();
    self.InstrCount := 0;
    self.Sections := new TObjectList();
    self.Sections.Add((NewPlaySeq("Section 1")) as int64);
    self.SectionCount := 1;
    self.CurSection := 0;
    self.Tempo := 125;
    self.Tpl := 6;
    self.Lpb := 4;
    self.MasterVolume := 64;
    self.HexVolumes := true;
    self.BpmMode := false;
    self.EightChannel := false;
  }

  fn Destroy(): void {
    if (self.Blocks != null) { self.Blocks.Destroy(); }
    if (self.Instruments != null) { self.Instruments.Destroy(); }
    if (self.Sections != null) { self.Sections.Destroy(); }
  }

  fn AddBlock(b: TBlock): int64 {
    var idx: int64 := self.Blocks.Add(b as int64);
    self.BlockCount := self.Blocks.Count;
    return idx;
  }

  fn BlockAt(i: int64): TBlock {
    if (i < 0) { return null; }
    if (i >= self.BlockCount) { return null; }
    return self.Blocks.Get(i) as TBlock;
  }

  fn AddInstrument(ins: TInstrument): int64 {
    var idx: int64 := self.Instruments.Add(ins as int64);
    self.InstrCount := self.Instruments.Count;
    return idx;
  }

  // Instrumentnummern sind 1-basiert wie in OctaMED (01..3F); Nummer 0
  // bedeutet in einer Zelle "kein Instrumentwechsel" und ist deshalb kein
  // gueltiger Listenindex.
  fn Instrument(number: int64): TInstrument {
    if (number < 1) { return null; }
    if (number > self.InstrCount) { return null; }
    return self.Instruments.Get(number - 1) as TInstrument;
  }

  // Block an einer Line teilen. Der untere Teil wird ein neuer Block direkt
  // hinter dem alten, und die Playing Sequence zieht mit: jeder Eintrag hinter
  // der Einfuegestelle ruecke sonst auf einen falschen Block.
  fn SplitBlockAt(index: int64, line: int64): bool {
    var b: TBlock := self.BlockAt(index);
    if (b == null) { return false; }
    var rest: TBlock := SplitBlock(b, line);
    if (rest == null) { return false; }

    self.Blocks.Insert(index + 1, rest as int64);
    self.BlockCount := self.Blocks.Count;
    self.RenumberSequences(index + 1, 1);
    return true;
  }

  // Block mit seinem Nachfolger verschmelzen. Der Nachfolger verschwindet,
  // also muessen alle Sequenzeintraege nachgezogen werden.
  fn JoinWithNext(index: int64): bool {
    var a: TBlock := self.BlockAt(index);
    var b: TBlock := self.BlockAt(index + 1);
    if (a == null) { return false; }
    if (b == null) { return false; }

    var merged: TBlock := JoinBlocks(a, b);
    if (merged == null) { return false; }
    self.Blocks.Put(index, merged as int64);
    self.Blocks.Delete(index + 1);
    self.BlockCount := self.Blocks.Count;

    // Wer auf den verschluckten Block zeigte, zeigt jetzt auf den
    // verschmolzenen; alles dahinter rutscht eine Nummer nach vorn.
    var si: int64 := 0;
    while (si < self.SectionCount) {
      var seq: TPlaySeq := self.Section(si);
      if (seq != null) {
        var k: int64 := 0;
        while (k < seq.Len) {
          var no: int64 := seq.Get(k);
          if (no == index + 1) { seq.Put(k, index); }
          else {
            if (no > index + 1) { seq.Put(k, no - 1); }
          }
          k := k + 1;
        }
      }
      si := si + 1;
    }
    return true;
  }

  // Blocknummern in allen Sections ab "from" um "delta" verschieben.
  fn RenumberSequences(from: int64, delta: int64): void {
    var si: int64 := 0;
    while (si < self.SectionCount) {
      var seq: TPlaySeq := self.Section(si);
      if (seq != null) {
        var k: int64 := 0;
        while (k < seq.Len) {
          var no: int64 := seq.Get(k);
          if (no >= from) { seq.Put(k, no + delta); }
          k := k + 1;
        }
      }
      si := si + 1;
    }
  }

  fn Section(i: int64): TPlaySeq {
    if (i < 0) { return null; }
    if (i >= self.SectionCount) { return null; }
    return self.Sections.Get(i) as TPlaySeq;
  }

  // Die gerade gueltige Sequence. Alles, was nur EINE Sequence kennt (das
  // Replay, die Anzeige), fragt hier — so bleibt der Umstieg auf Sections
  // eine Sache dieses Songs und nicht aller Aufrufer.
  fn Seq(): TPlaySeq {
    return self.Section(self.CurSection);
  }

  fn AddSection(name: pchar): int64 {
    var s: TPlaySeq := NewPlaySeq(name);
    var idx: int64 := self.Sections.Add(s as int64);
    self.SectionCount := self.Sections.Count;
    return idx;
  }

  fn SeqLen(): int64 {
    var s: TPlaySeq := self.Seq();
    if (s == null) { return 0; }
    return s.Len;
  }

  fn AddSequenceEntry(blockNo: int64): void {
    var s: TPlaySeq := self.Seq();
    if (s == null) { return; }
    s.Add(blockNo);
  }

  fn SequenceEntry(i: int64): int64 {
    var s: TPlaySeq := self.Seq();
    if (s == null) { return 0; }
    return s.Get(i);
  }
}

// Block an einer Line teilen: der obere Teil bleibt im Block, der untere wird
// zum Rueckgabewert. Beide behalten ihre Trackzahl — geteilt wird die Zeit,
// nicht die Besetzung.
pub fn SplitBlock(b: TBlock, atLine: int64): TBlock {
  if (b == null) { return null; }
  if (atLine < 1) { return null; }
  if (atLine >= b.Lines) { return null; }

  var rest: TBlock := NewBlock(b.Tracks, b.Lines - atLine);
  rest.Name := b.Name;
  var line: int64 := atLine;
  while (line < b.Lines) {
    var track: int64 := 0;
    while (track < b.Tracks) {
      rest.PutCell(line - atLine, track, b.Cell(line, track));
      track := track + 1;
    }
    line := line + 1;
  }
  b.Resize(b.Tracks, atLine);
  return rest;
}

// Zwei Blocks hintereinanderhaengen. Die Trackzahl richtet sich nach dem
// breiteren der beiden; was der schmalere nicht hat, bleibt leer.
pub fn JoinBlocks(a: TBlock, b: TBlock): TBlock {
  if (a == null) { return null; }
  if (b == null) { return null; }

  var tracks: int64 := a.Tracks;
  if (b.Tracks > tracks) { tracks := b.Tracks; }
  var res: TBlock := NewBlock(tracks, a.Lines + b.Lines);
  res.Name := a.Name;

  var line: int64 := 0;
  while (line < a.Lines) {
    var track: int64 := 0;
    while (track < a.Tracks) {
      res.PutCell(line, track, a.Cell(line, track));
      track := track + 1;
    }
    line := line + 1;
  }
  line := 0;
  while (line < b.Lines) {
    var track2: int64 := 0;
    while (track2 < b.Tracks) {
      res.PutCell(a.Lines + line, track2, b.Cell(line, track2));
      track2 := track2 + 1;
    }
    line := line + 1;
  }
  return res;
}

pub fn NewSong(name: pchar): TSong {
  return new TSong(name);
}

// ---- Zellen als Text -------------------------------------------------------
// Schreibt eine Zelle als "C-3 01 000" (ext = false) bzw. "C-3 01 0C40"
// (ext = true) in einen Puffer des Aufrufers und terminiert mit 0.
// Rueckgabe: Zahl der geschriebenen Zeichen.
//
// Der Aufrufer haelt den Puffer, weil das im Blockeditor pro Frame hunderte
// Male passiert — ein neuer TTextBuffer je Zelle waere hunderte Allokationen
// pro Bild.
pub fn CellToText(buf: int64, cell: int64, ext: bool): int64 {
  var note: int64 := CellNote(cell);
  var i: int64 := 0;

  if (note == 0) {
    poke8(buf, 45); poke8(buf + 1, 45); poke8(buf + 2, 45);   // "---"
  } else {
    var nm: pchar := SemitoneName(NoteSemitone(note));
    poke8(buf, peek8(nm as int64));
    poke8(buf + 1, peek8((nm as int64) + 1));
    poke8(buf + 2, 48 + (NoteOctave(note) % 10));
  }
  i := 3;
  poke8(buf + i, 32); i := i + 1;

  var ins: int64 := CellInstr(cell);
  poke8(buf + i, HexDigit(ins >> 4)); i := i + 1;
  poke8(buf + i, HexDigit(ins)); i := i + 1;
  poke8(buf + i, 32); i := i + 1;

  var cmd: int64 := CellCmd(cell);
  var lev: int64 := CellLevel(cell);
  if (ext) {
    poke8(buf + i, HexDigit(cmd >> 4)); i := i + 1;
  }
  poke8(buf + i, HexDigit(cmd)); i := i + 1;
  poke8(buf + i, HexDigit(lev >> 4)); i := i + 1;
  poke8(buf + i, HexDigit(lev)); i := i + 1;

  poke8(buf + i, 0);
  return i;
}

// Breite einer Zelle in Zeichen: "C-3 01 000" = 10, erweitert 11.
pub fn CellTextWidth(ext: bool): int64 {
  if (ext) { return 11; }
  return 10;
}

// Zeilennummer zweistellig hex ("3F") — OctaMED zeigt sie hexadezimal, wenn
// Hex-Anzeige aktiv ist, sonst dezimal.
pub fn LineNoToText(buf: int64, line: int64, hex: bool): void {
  if (hex) {
    poke8(buf, HexDigit(line >> 4));
    poke8(buf + 1, HexDigit(line));
    poke8(buf + 2, 0);
    return;
  }
  poke8(buf, 48 + ((line / 10) % 10));
  poke8(buf + 1, 48 + (line % 10));
  poke8(buf + 2, 0);
}
