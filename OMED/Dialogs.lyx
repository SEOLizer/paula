  _sq_song := song;

  _sq_title := AddLabel(f as TControl, 10, 8, "");
  _sq_title.Width := 200;

  var bPrev: TOmedButton := NewOmedButton("<");
  bPrev.Left := 220; bPrev.Top := 6; bPrev.Width := 32;
  bPrev.OnClick := SqPrevSection;
  f.AddChild(bPrev);

  var bNext: TOmedButton := NewOmedButton(">");
  bNext.Left := 256; bNext.Top := 6; bNext.Width := 32;
  bNext.OnClick := SqNextSection;
  f.AddChild(bNext);

  var bNewSec: TOmedButton := NewOmedButton("New");
  bNewSec.Left := 292; bNewSec.Top := 6; bNewSec.Width := 56;
  bNewSec.OnClick := SqNewSection;
  f.AddChild(bNewSec);

  _sq_list := NewOmedList("PLAYING SEQUENCE");
  _sq_list.Left := 10;
  _sq_list.Top := 34;
  _sq_list.Width := 338;
  _sq_list.Height := 240;
  f.AddChild(_sq_list as TControl);

  AddLabel(f as TControl, 10, 286, "Block:");
  _sq_edit := AddEdit(f as TControl, 66, 284, 50, "0");

  var bAdd: TOmedButton := NewOmedButton("Add");
  bAdd.Left := 126; bAdd.Top := 284; bAdd.Width := 60;
  bAdd.OnClick := SqAdd;
  f.AddChild(bAdd);

  var bIns: TOmedButton := NewOmedButton("Insert");
  bIns.Left := 190; bIns.Top := 284; bIns.Width := 70;
  bIns.OnClick := SqInsert;
  f.AddChild(bIns);

  var bDel: TOmedButton := NewOmedButton("Delete");
  bDel.Left := 264; bDel.Top := 284; bDel.Width := 84;
  bDel.OnClick := SqDelete;
  f.AddChild(bDel);

  var bUp: TOmedButton := NewOmedButton("Up");
  bUp.Left := 10; bUp.Top := 316; bUp.Width := 60;
  bUp.OnClick := SqUp;
  f.AddChild(bUp);

  var bDown: TOmedButton := NewOmedButton("Down");
  bDown.Left := 74; bDown.Top := 316; bDown.Width := 70;
  bDown.OnClick := SqDown;
  f.AddChild(bDown);

  var bClose: TOmedButton := NewOmedButton("Close");
  bClose.Left := 268; bClose.Top := 316; bClose.Width := 80;
  bClose.OnClick := SqClose;
  f.AddChild(bClose);

  SqRefresh();
  app.ShowModal(f);

  _sq_form := null;
  _sq_song := null;
  _sq_list := null;
  _sq_title := null;
  _sq_edit := null;
}

// ============================================================================
// Instrument Properties
// ============================================================================
// Die Felder stammen 1:1 aus der MMD-Instrumentstruktur. MIDI-Kanal und
// -Preset stehen bewusst im selben Fenster wie Volume und Transpose: ob ein
// Instrument ein Sample oder ein MIDI-Klang ist, entscheidet genau eines
// dieser Felder (midich), und das soll man sehen, ohne das Fenster zu
// wechseln.

var _ip_form: TForm;

fn IpOk(sender: TControl): void {
  if (_ip_form != null) { _ip_form.ModalResult := mrOk; }
}

fn IpCancel(sender: TControl): void {
  if (_ip_form != null) { _ip_form.ModalResult := mrCancel; }
}

pub fn ShowInstrumentProperties(app: TApplication, ins: TInstrument,
                                number: int64): bool {
  if (ins == null) { return false; }

  var f: TForm := NewForm(330, 300, "Instrument Properties");
  f.Position := POS_MAIN_CENTER;
  _ip_form := f;

  var tb: TTextBuffer := new TTextBuffer();

  AddLabel(f as TControl, 12, 14, "Name:");
  var eName: TEdit := AddEdit(f as TControl, 130, 12, 180, ins.Name);

  AddLabel(f as TControl, 12, 46, "Volume:");
  IntToText(tb, ins.Volume);
  var eVol: TEdit := AddEdit(f as TControl, 130, 44, 60, tb.AsPChar());

  AddLabel(f as TControl, 12, 78, "Transpose:");
  IntToText(tb, ins.Transpose);
  var eTrans: TEdit := AddEdit(f as TControl, 130, 76, 60, tb.AsPChar());

  AddLabel(f as TControl, 12, 110, "Fine Tune:");
  IntToText(tb, ins.FineTune);
  var eFine: TEdit := AddEdit(f as TControl, 130, 108, 60, tb.AsPChar());

  AddLabel(f as TControl, 12, 142, "MIDI Channel:");
  IntToText(tb, ins.MidiChannel);
  var eChan: TEdit := AddEdit(f as TControl, 130, 140, 60, tb.AsPChar());

  AddLabel(f as TControl, 12, 174, "MIDI Preset:");
  IntToText(tb, ins.MidiPreset);
  var ePreset: TEdit := AddEdit(f as TControl, 130, 172, 60, tb.AsPChar());

  var bOk: TOmedButton := NewOmedButton("OK");
  bOk.Left := 140; bOk.Top := 230; bOk.Width := 80;
  bOk.OnClick := IpOk;
  f.AddChild(bOk);

  var bCancel: TOmedButton := NewOmedButton("Cancel");
  bCancel.Left := 228; bCancel.Top := 230; bCancel.Width := 82;
  bCancel.OnClick := IpCancel;
  f.AddChild(bCancel);

  f.Dispatcher.SetFocus(eName as TControl);
  var res: int64 := app.ShowModal(f);

  var ok: bool := false;
  if (res == mrOk) {
    var nb: TTextBuffer := new TTextBuffer();
    nb.SetText(eName.GetText());
    ins.Name := nb.AsPChar();

    var v: int64 := ParseInt(eVol.GetText());
    if (v > 64) { v := 64; }
    ins.Volume := v;
    ins.Transpose := ParseInt(eTrans.GetText());
    var ft: int64 := ParseInt(eFine.GetText());
    if (ft > 7) { ft := 7; }
    ins.FineTune := ft;

    // MIDI-Kanal 0 heisst "kein MIDI" — das ist der Schalter, der aus einem
    // Sampleinstrument ein MIDI-Instrument macht.
    var mc: int64 := ParseInt(eChan.GetText());
    if (mc > 16) { mc := 16; }
    ins.MidiChannel := mc;
    var mp: int64 := ParseInt(ePreset.GetText());
    if (mp > 128) { mp := 128; }
    ins.MidiPreset := mp;
    ok := true;
  }

  tb.Destroy();
  _ip_form := null;
  return ok;
}

// ============================================================================
// MIDI Setup
// ============================================================================
// Ein Pfad und zwei Knoepfe. Mehr braucht es nicht: die Ausgabe ist ein roher
// Bytestrom in eine Geraetedatei (/dev/midi1 und Verwandte). Zeigt der Pfad
// auf eine gewoehnliche Datei, entsteht dort eine Mitschrift — die einzige
// Art, die Ausgabe ohne MIDI-Hardware nachzupruefen.

var _ms_form: TForm;
var _ms_midi: TMidiOut;
var _ms_edit: TEdit;
var _ms_state: TLabel;

fn MsShowState(): void {
  if (_ms_state == null) { return; }
  if (_ms_midi == null) { return; }
  if (_ms_midi.IsOpen()) { _ms_state.Caption := "Status: offen"; }
  else { _ms_state.Caption := "Status: geschlossen"; }
  _ms_state.Invalidate();
}

fn MsOpen(sender: TControl): void {
  if (_ms_midi == null) { return; }
  if (_ms_edit == null) { return; }
  var nb: TTextBuffer := new TTextBuffer();
  nb.SetText(_ms_edit.GetText());
  if (!_ms_midi.Open(nb.AsPChar())) {
    if (_ms_state != null) {
      _ms_state.Caption := "Status: Geraet nicht erreichbar";
      _ms_state.Invalidate();
    }
    return;
  }
  MsShowState();
}

fn MsClose(sender: TControl): void {
  if (_ms_midi == null) { return; }
  _ms_midi.AllNotesOff();
  _ms_midi.Close();
  MsShowState();
}

fn MsDone(sender: TControl): void {
  if (_ms_form != null) { _ms_form.ModalResult := mrOk; }
}

pub fn ShowMidiSetup(app: TApplication, midi: TMidiOut): void {
  if (midi == null) { return; }

  var f: TForm := NewForm(400, 180, "MIDI Setup");
  f.Position := POS_MAIN_CENTER;
  _ms_form := f;
  _ms_midi := midi;

  AddLabel(f as TControl, 12, 16, "Device:");
  var path: pchar := "/dev/midi1";
  if (midi.IsOpen()) { path := midi.Path; }
  _ms_edit := AddEdit(f as TControl, 90, 14, 290, path);

  _ms_state := AddLabel(f as TControl, 12, 52, "");
  _ms_state.Width := 300;

  var bOpen: TOmedButton := NewOmedButton("Open");
  bOpen.Left := 12; bOpen.Top := 110; bOpen.Width := 80;
  bOpen.OnClick := MsOpen;
  f.AddChild(bOpen);

  var bClose: TOmedButton := NewOmedButton("Close");
  bClose.Left := 100; bClose.Top := 110; bClose.Width := 80;
  bClose.OnClick := MsClose;
  f.AddChild(bClose);

  var bDone: TOmedButton := NewOmedButton("Done");
  bDone.Left := 300; bDone.Top := 110; bDone.Width := 80;
  bDone.OnClick := MsDone;
  f.AddChild(bDone);

  MsShowState();
  app.ShowModal(f);

  _ms_form := null;
  _ms_midi := null;
  _ms_edit := null;
  _ms_state := null;
}
