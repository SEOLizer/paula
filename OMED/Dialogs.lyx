// OMED/Dialogs.lyx — die kleinen Fenster.
//
// OctaMED hatte keine eingeblendeten Bereiche im Hauptfenster, sondern echte
// kleine Fenster: Block Properties, Song Sequence, Instrument Properties. Das
// ist kein Zierrat — man laesst die Sequence offen, waehrend man im Block
// tippt, und genau das kann ein Panel nicht.
//
// Phase 8 bringt zwei davon: Block Properties und Song Sequence (inklusive
// Sections).

@description("OctaMED-Tracker - Dialogfenster")
@author("Andreas Roene")
unit OMED.Dialogs;

import Vega.Types;
import Vega.Control;
import Vega.Forms;
import Vega.StdCtrls;
import Vega.Edits;
import Vega.Strings;
import Vega.Font;
import OMED.Theme;
import OMED.Song;
import OMED.Widgets;
import OMED.Midi;

// Zahl aus einem Eingabefeld. Alles, was keine Ziffer ist, beendet die Zahl —
// ein Feld, das bei einem Tippfehler eine riesige Blocklaenge liefert, waere
// gefaehrlicher als eines, das die Eingabe frueh abschneidet.
pub fn ParseInt(s: pchar): int64 {
  var p: int64 := s as int64;
  if (p == 0) { return 0; }
  var v: int64 := 0;
  var i: int64 := 0;
  while (true) {
    var c: int64 := peek8(p + i);
    if (c == 0) { return v; }
    if (c < 48) { return v; }
    if (c > 57) { return v; }
    v := (v * 10) + (c - 48);
    if (v > 100000) { return 100000; }
    i := i + 1;
  }
  return v;
}

fn IntToText(dst: TTextBuffer, v: int64): void {
  var buf: int64 := alloc(24);
  var n: int64 := v;
  if (n < 0) { n := 0; }
  var digits: int64 := 1;
  var t: int64 := n / 10;
  while (t > 0) { digits := digits + 1; t := t / 10; }
  poke8(buf + digits, 0);
  var i: int64 := digits;
  while (i > 0) {
    i := i - 1;
    poke8(buf + i, 48 + (n % 10));
    n := n / 10;
  }
  dst.SetText(buf as pchar);
  free(buf, 24);
}

fn AddLabel(owner: TControl, x: int64, y: int64, caption: pchar): TLabel {
  var l: TLabel := new TLabel(caption);
  l.Left := x;
  l.Top := y;
  l.Width := 110;
  l.Height := 18;
  owner.AddChild(l);
  return l;
}

fn AddEdit(owner: TControl, x: int64, y: int64, w: int64, text: pchar): TEdit {
  var e: TEdit := new TEdit(text);
  e.Left := x;
  e.Top := y;
  e.Width := w;
  e.Height := 22;
  owner.AddChild(e);
  return e;
}

// ============================================================================
// Block Properties
// ============================================================================
// Name, Trackzahl und Linezahl — in OctaMED gehoeren die dem Block und nicht
// dem Song (anders als bei ProTracker, wo alle Patterns gleich gross sind).
// Genau deshalb steht das hier in einem Blockfenster.

var _bp_result: int64;
var _bp_form: TForm;

fn BpOk(sender: TControl): void {
  _bp_result := mrOk;
  if (_bp_form != null) { _bp_form.ModalResult := mrOk; }
}

fn BpCancel(sender: TControl): void {
  _bp_result := mrCancel;
  if (_bp_form != null) { _bp_form.ModalResult := mrCancel; }
}

pub fn ShowBlockProperties(app: TApplication, b: TBlock, blockNo: int64): bool {
  if (b == null) { return false; }

  var f: TForm := NewForm(300, 190, "Block Properties");
  f.Position := POS_MAIN_CENTER;
  _bp_form := f;
  _bp_result := mrCancel;

  AddLabel(f as TControl, 12, 14, "Name:");
  var eName: TEdit := AddEdit(f as TControl, 110, 12, 170, b.Name);

  AddLabel(f as TControl, 12, 46, "Tracks:");
  var tb: TTextBuffer := new TTextBuffer();
  IntToText(tb, b.Tracks);
  var eTracks: TEdit := AddEdit(f as TControl, 110, 44, 60, tb.AsPChar());

  AddLabel(f as TControl, 12, 78, "Lines:");
  IntToText(tb, b.Lines);
  var eLines: TEdit := AddEdit(f as TControl, 110, 76, 60, tb.AsPChar());

  var bOk: TOmedButton := NewOmedButton("OK");
  bOk.Left := 110;
  bOk.Top := 130;
  bOk.Width := 80;
  bOk.OnClick := BpOk;
  f.AddChild(bOk);

  var bCancel: TOmedButton := NewOmedButton("Cancel");
  bCancel.Left := 198;
  bCancel.Top := 130;
  bCancel.Width := 82;
  bCancel.OnClick := BpCancel;
  f.AddChild(bCancel);

  f.Dispatcher.SetFocus(eName as TControl);
  var res: int64 := app.ShowModal(f);

  var ok: bool := false;
  if (res == mrOk) {
    // Der Name wird kopiert: das Eingabefeld gibt seinen eigenen Puffer
    // heraus, und der stirbt mit dem Fenster.
    var nb: TTextBuffer := new TTextBuffer();
    nb.SetText(eName.GetText());
    b.Name := nb.AsPChar();
    b.Resize(ParseInt(eTracks.GetText()), ParseInt(eLines.GetText()));
    ok := true;
  }

  tb.Destroy();
  _bp_form := null;
  return ok;
}

// ============================================================================
// Song Sequence
// ============================================================================
// Die Playing Sequence als das, was sie ist: eine Liste von Blocknummern, in
// der ein Block mehrfach vorkommen darf. Darueber die Sections (V5) — mehrere
// solcher Listen nebeneinander.

var _sq_form: TForm;
var _sq_song: TSong;
var _sq_list: TOmedList;
var _sq_title: TLabel;
var _sq_edit: TEdit;

fn SqRefresh(): void {
  if (_sq_list == null) { return; }
  if (_sq_song == null) { return; }
  var seq: TPlaySeq := _sq_song.Seq();
  if (seq == null) { return; }

  var sel: int64 := _sq_list.Sel;
  _sq_list.ClearEntries();
  var i: int64 := 0;
  while (i < seq.Len) {
    var no: int64 := seq.Get(i);
    var b: TBlock := _sq_song.BlockAt(no);
    var name: pchar := "(leer)";
    if (b != null) { name := b.Name; }
    // Die Nummer der Liste ist der BLOCK, nicht die Position: beim Lesen
    // sucht man den Block, die Position zaehlt man ohnehin von oben ab.
    _sq_list.AddEntry(no, name);
    i := i + 1;
  }
  if (sel >= seq.Len) { sel := seq.Len - 1; }
  if (sel < 0) { sel := 0; }
  _sq_list.Sel := sel;
  _sq_list.Invalidate();

  if (_sq_title != null) {
    var seqName: pchar := "";
    if (seq.Name != 0) { seqName := seq.Name; }
    _sq_title.Caption := seqName;
    _sq_title.Invalidate();
  }
}

// Die Blocknummer, mit der die Knoepfe arbeiten: was im Eingabefeld steht.
fn SqBlockNo(): int64 {
  if (_sq_edit == null) { return 0; }
  var no: int64 := ParseInt(_sq_edit.GetText());
  if (_sq_song != null) {
    if (no >= _sq_song.BlockCount) { no := _sq_song.BlockCount - 1; }
  }
  if (no < 0) { no := 0; }
  return no;
}

fn SqAdd(sender: TControl): void {
  if (_sq_song == null) { return; }
  var seq: TPlaySeq := _sq_song.Seq();
  if (seq == null) { return; }
  seq.Add(SqBlockNo());
  SqRefresh();
}

fn SqInsert(sender: TControl): void {
  if (_sq_song == null) { return; }
  var seq: TPlaySeq := _sq_song.Seq();
  if (seq == null) { return; }
  seq.Insert(_sq_list.Sel, SqBlockNo());
  SqRefresh();
}

fn SqDelete(sender: TControl): void {
  if (_sq_song == null) { return; }
  var seq: TPlaySeq := _sq_song.Seq();
  if (seq == null) { return; }
  seq.Remove(_sq_list.Sel);
  SqRefresh();
}

fn SqUp(sender: TControl): void {
  if (_sq_song == null) { return; }
  var seq: TPlaySeq := _sq_song.Seq();
  if (seq == null) { return; }
  var i: int64 := _sq_list.Sel;
  if (i <= 0) { return; }
  seq.Swap(i, i - 1);
  _sq_list.Sel := i - 1;
  SqRefresh();
}

fn SqDown(sender: TControl): void {
  if (_sq_song == null) { return; }
  var seq: TPlaySeq := _sq_song.Seq();
  if (seq == null) { return; }
  var i: int64 := _sq_list.Sel;
  if (i >= seq.Len - 1) { return; }
  seq.Swap(i, i + 1);
  _sq_list.Sel := i + 1;
  SqRefresh();
}

fn SqPrevSection(sender: TControl): void {
  if (_sq_song == null) { return; }
  if (_sq_song.CurSection <= 0) { return; }
  _sq_song.CurSection := _sq_song.CurSection - 1;
  SqRefresh();
}

fn SqNextSection(sender: TControl): void {
  if (_sq_song == null) { return; }
  if (_sq_song.CurSection >= _sq_song.SectionCount - 1) { return; }
  _sq_song.CurSection := _sq_song.CurSection + 1;
  SqRefresh();
}

fn SqNewSection(sender: TControl): void {
  if (_sq_song == null) { return; }
  _sq_song.CurSection := _sq_song.AddSection("Section");
  SqRefresh();
}

fn SqClose(sender: TControl): void {
  if (_sq_form != null) { _sq_form.ModalResult := mrOk; }
}

