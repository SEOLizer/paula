// ---- Fenster ---------------------------------------------------------------
// Vegas ApplyLayout setzt Left/Top/Width/Height der Kinder DIREKT und nicht
// ueber SetBounds — ein verschachtelter Container erfaehrt davon also nichts
// und wuerde seine eigenen Kinder nie ausrichten. Deshalb zieht dieser
// Handler die Layouts der Container nach, und die Menueleiste ihre Breite:
// SetMenu setzt sie einmalig aus der damaligen Fensterbreite.
fn OnMainResize(sender: TControl): void {
  if (g_form == null) { return; }
  if (g_form.Menu != 0) { g_form.Menu.Width := g_form.Width; }
  if (g_lists != null) { g_lists.ApplyLayout(); }
  g_form.Invalidate();
}

fn BuildMainWindow(app: TApplication): TForm {
  var f: TForm := NewForm(WIN_W, WIN_H, "Paula");
  g_form := f;
  f.OnResize := OnMainResize;
  BuildMenu(f);

  // 0. Platzhalter in Hoehe der Menueleiste. Die Leiste selbst liegt als
  //    Kind auf 0/0 und wird ZULETZT gezeichnet, ist aber am Layout nicht
  //    beteiligt — ohne diesen Streifen legt sich die Infozeile darueber.
  var menuspace: TOmedMenuSpacer := NewOmedMenuSpacer(f.MenuHeight());
  f.AddChild(menuspace);

  // 1. Infozeile oben
  g_info := NewOmedInfoBar();
  g_info.Attach(g_song);
  g_info.ShowBlock(g_block_no);
  g_info.Align := AL_TOP;
  f.AddChild(g_info);

  // 2. Transportzeile und Eingabezeile unten — vor dem Blockeditor, damit
  //    ApplyLayout ihnen ihren Rand zuteilt.
  var transport: TControl := new TControl();
  transport.Height := 26;
  transport.Align := AL_BOTTOM;
  transport.Color := OmGrey();
  f.AddChild(transport);
  g_transport := transport;

  var bPlaySong: TOmedButton := NewOmedButton("Play Song");
  bPlaySong.Left := 4;
  bPlaySong.Top := 3;
  bPlaySong.Width := 88;
  bPlaySong.OnClick := ActPlaySong;
  transport.AddChild(bPlaySong);

  var bPlayBlock: TOmedButton := NewOmedButton("Play Block");
  bPlayBlock.Left := 96;
  bPlayBlock.Top := 3;
  bPlayBlock.Width := 92;
  bPlayBlock.OnClick := ActPlayBlock;
  transport.AddChild(bPlayBlock);

  var bStop: TOmedButton := NewOmedButton("Stop");
  bStop.Left := 192;
  bStop.Top := 3;
  bStop.Width := 56;
  bStop.OnClick := ActStop;
  transport.AddChild(bStop);

  var bRec: TOmedButton := NewOmedButton("Rec");
  bRec.Left := 252;
  bRec.Top := 3;
  bRec.Width := 48;
  transport.AddChild(bRec);

  g_editbar := NewOmedEditBar();
  g_editbar.Attach(g_song);
  g_editbar.Align := AL_BOTTOM;
  f.AddChild(g_editbar);

  // 3. Instrument- und Blockliste als unterer Streifen
  var lists: TControl := new TControl();
  lists.Height := 156;
  lists.Align := AL_BOTTOM;
  lists.Color := OmGrey();
  f.AddChild(lists);
  g_lists := lists;

  g_instr := NewOmedList("INSTRUMENT / SAMPLE");
  g_instr.Width := 300;
  g_instr.Align := AL_LEFT;
  lists.AddChild(g_instr);

  g_blocks := NewOmedList("SONG / BLOCK LIST");
  g_blocks.Align := AL_CLIENT;
  lists.AddChild(g_blocks);

  // 4. Blockeditor bekommt den Rest
  g_grid := NewOmedGrid();
  g_grid.Align := AL_CLIENT;
  g_grid.Attach(g_song, g_song.BlockAt(g_block_no));
  // Instrument, Oktave und Step der Eingabe stehen in der EditBar; das Grid
  // liest sie von dort, statt sie zu spiegeln.
  g_grid.Bar := g_editbar;
  g_grid.OnNote := PreviewNote;
  f.AddChild(g_grid);

  g_blocks.OnSelect := ActSelectBlock;
  g_instr.OnSelect := ActSelectInstr;
  FillLists();

  if (!app.ShowForm(f)) { return null; }
  // Einmal von Hand, damit die Aufteilung schon beim ersten Bild stimmt und
  // nicht erst nach der ersten Groessenaenderung.
  f.ApplyLayout();
  OnMainResize(f);

  // Der Blockeditor ist die Eingabestelle des Programms: er hat den Fokus ab
  // dem ersten Bild, sonst laufen die Pfeiltasten ins Leere, bis jemand
  // hineinklickt.
  f.Dispatcher.SetFocus(g_grid as TControl);
  return f;
}

// Instrumentliste und Blockliste aus dem Song fuellen.
fn FillLists(): void {
  if (g_song == null) { return; }

  g_instr.ClearEntries();
  var i: int64 := 1;
  while (i <= g_song.InstrCount) {
    var ins: TInstrument := g_song.Instrument(i);
    if (ins != null) { g_instr.AddEntry(i, ins.Name); }
    i := i + 1;
  }

  g_blocks.ClearEntries();
  var b: int64 := 0;
  while (b < g_song.BlockCount) {
    var blk: TBlock := g_song.BlockAt(b);
    if (blk != null) { g_blocks.AddEntry(b, blk.Name); }
    b := b + 1;
  }
}

fn main(): int64 {
  var app: TApplication := NewApplication(NewX11Backend());
  if (!app.Ready) {
    PrintStrLn("Paula: X11-Backend nicht verfuegbar (DISPLAY gesetzt?)");
    return 1;
  }

  // Erst das Theme, dann die Controls: ein Control liest seine Farben beim
  // Zeichnen, aber StyleType und Metriken stehen im Konstruktor fest.
  if (!UsePaulaTheme("paula.theme")) {
    PrintStrLn("Paula: paula.theme nicht gefunden - Anzeige im Vega-Standardtheme");
  }

  g_block_no := 0;
  g_song := BuildDemoSong();

  // Audio: Backend, Ausgabe und Mischpuffer. Faellt die Ausgabe aus (keine
  // Soundkarte, kein ALSA), laeuft der Editor weiter — nur eben stumm. Ein
  // Tracker, der ohne Audio gar nicht erst startet, waere beim Tippen
  // nutzlos.
  // Vorgabe ist der Paula-Modus: das Programm soll klingen wie das Original,
  // und der moderne Mixer ist die Abweichung, die man bewusst waehlt.
  SetPlaybackMode(MODE_PAULA);
  g_pcm_frames := (OM_MIX_RATE * PREVIEW_MS) / 1000;
  g_pcm := alloc(g_pcm_frames * 4);
  g_audio := NewOmedAudio();
  if (!g_audio.Open()) {
    PrintStrLn("Paula: keine Audioausgabe - Vorhoeren bleibt stumm");
  }

  // Ein Tick ist beim langsamsten Tempo am laengsten; der Puffer wird einmal
  // fuer diesen Fall angelegt und nie wieder angefasst.
  g_tick_buf := alloc((OM_MIX_RATE / 4) * 4);
  g_replay := NewReplayEngine();
  g_replay.Attach(g_song, g_backend);
  // Die MIDI-Ausgabe bleibt zu, bis jemand im MIDI Setup ein Geraet oeffnet.
  // Ein Tracker, der beim Start in eine Geraetedatei schreibt, die es
  // vielleicht gar nicht gibt, waere zudringlich.
  g_midi := NewMidiOut();
  g_replay.Midi := g_midi;

  // Bis ein Sample geladen ist, bekommt jedes Instrument einen Ersatzklang.
  // Sonst waere der Editor beim ersten Start lautlos, und man haette keinen
  // Anhaltspunkt, ob Eingabe und Tonhoehe stimmen.
  // Ersatzklaenge nach Art des Instruments: Bass, Pad und Lead halten ihren
  // Ton ueber eine Schleife, solange die Note steht. Snare und Hi-Hats sind
  // Schlagwerk — eine Schleife wuerde dort durchdroehnen.
  var n: int64 := 1;
  while (n <= 6) {
    var ins: TInstrument := g_song.Instrument(n);
    if (ins != null) {
      if (ins.SampleData == 0) {
        if (n == 1) {
          MakeHeldSample(ins, 96, 40);                      // Bass, tief
          ins.Hold := 10;                                   // knapp zwei Lines
          ins.Decay := 6;
        } else {
          if (n == 5) {
            MakeHeldSample(ins, 48, 40);                    // Pad, traegt lang
            ins.Hold := 30;
            ins.Decay := 2;
          } else {
            if (n == 6) {
              MakeHeldSample(ins, 24, 40);                  // Lead
              ins.Hold := 14;
              ins.Decay := 5;
            } else {
              MakeSquareSample(ins, 32, 24);                // Snare, Hi-Hats
            }
          }
        }
      }
    }
    n := n + 1;
  }

  g_app := app;
  var f: TForm := BuildMainWindow(app);
  if (f == null) {
    PrintStrLn("Paula: Fenster konnte nicht angelegt werden");
    return 2;
  }

  // Der Timer laeuft immer; ohne laufendes Replay tut sein Handler nichts.
  // 20 ms sind die 50 Ticks je Sekunde des PAL-Amiga bei Tempo 125.
  g_timer := NewTimer(20);
  g_timer.OnTimer := OnReplayTick;
  g_timer.Start();
  app.AddTimer(g_timer);

  app.Run();
  return 0;
}
