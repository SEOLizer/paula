// ---- Demo-Song -------------------------------------------------------------
// Ein kleiner Block mit Inhalt, damit beim ersten Start ein Raster zu sehen
// ist und nicht eine leere Flaeche. Entspricht dem Beispiel aus der README.
fn BuildDemoSong(): TSong {
  var s: TSong := NewSong("Demo Song");

  s.AddInstrument(NewInstrument("Bass"));
  s.AddInstrument(NewInstrument("Snare"));
  s.AddInstrument(NewInstrument("Closed Hat"));
  s.AddInstrument(NewInstrument("Open Hat"));
  s.AddInstrument(NewInstrument("Pad"));
  s.AddInstrument(NewInstrument("Lead"));

  var b: TBlock := NewBlock(4, 64);
  b.Name := "Intro";

  // Notennummer = (Oktave - 1) * 12 + Halbton + 1, denn 1 ist C-1.
  // C-3 = 25, D-3 = 27, E-3 = 29, G-2 = 20, A-3 = 34, C-4 = 37, A-4 = 46.
  b.PutCell(0, 0, CellPack(25, 1, 0, 0));      // C-3 01 000
  b.PutCell(0, 2, CellPack(20, 3, 0, 0));      // G-2 03 000
  b.PutCell(2, 1, CellPack(37, 2, 0, 0));      // C-4 02 000
  b.PutCell(4, 0, CellPack(29, 1, 0, 0x37));   // E-3 01 037
  b.PutCell(4, 2, CellPack(27, 3, 0, 0));      // D-3 03 000
  b.PutCell(8, 0, CellPack(25, 1, 0x0C, 0x40));// C-3 01 0C40 (Set Volume)
  b.PutCell(12, 3, CellPack(34, 5, 0, 0));     // A-3 05 000
  b.PutCell(16, 0, CellPack(25, 1, 0, 0));
  b.PutCell(16, 1, CellPack(37, 2, 0, 0));

  s.AddBlock(b);

  // "Main" war bis hierher ein Platzhalter mit zwei Noten auf Line 0 — beim
  // Abspielen folgten darauf 63 leere Lines, also rund acht Sekunden Stille
  // mitten im Stueck. Jetzt steht dort ein durchgehendes Muster: Bass auf
  // jedem Beat, Snare auf den Gegenschlag, Hi-Hats dazwischen und eine
  // Melodie darueber.
  var b2: TBlock := NewBlock(4, 64);
  b2.Name := "Main";

  var i: int64 := 0;
  while (i < 64) {
    // Track 0: Bass. C-2 auf der Eins, G-1 auf der Drei jedes Taktes.
    if ((i % 8) == 0) { b2.PutCell(i, 0, CellPack(13, 1, 0, 0)); }
    if ((i % 8) == 4) { b2.PutCell(i, 0, CellPack(8, 1, 0, 0)); }

    // Track 1: Snare auf den Gegenschlag.
    if ((i % 8) == 4) { b2.PutCell(i, 1, CellPack(25, 2, 0, 0)); }

    // Track 2: Hi-Hats, jede zweite Line, offen am Taktende.
    if ((i % 2) == 0) {
      if ((i % 8) == 6) { b2.PutCell(i, 2, CellPack(37, 4, 0, 0)); }
      else { b2.PutCell(i, 2, CellPack(37, 3, 0x0C, 0x20)); }
    }
    i := i + 1;
  }

  // Track 3: eine Melodie ueber zwei Takte, danach wiederholt sie sich.
  var mel: int64 := 0;
  while (mel < 64) {
    b2.PutCell(mel + 0, 3, CellPack(37, 6, 0, 0));        // C-4
    b2.PutCell(mel + 3, 3, CellPack(41, 6, 0, 0));        // E-4
    b2.PutCell(mel + 6, 3, CellPack(44, 6, 0, 0));        // G-4
    b2.PutCell(mel + 8, 3, CellPack(46, 6, 0x00, 0x37));  // A-4 mit Arpeggio
    b2.PutCell(mel + 12, 3, CellPack(44, 6, 0x0D, 0x02)); // G-4, ausblendend
    mel := mel + 16;
  }
  s.AddBlock(b2);

  // Playing Sequence: Intro einmal, Main zweimal.
  s.AddSequenceEntry(0);
  s.AddSequenceEntry(1);
  s.AddSequenceEntry(1);

  return s;
}

