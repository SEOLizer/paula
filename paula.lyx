// ---- Vorhoeren -------------------------------------------------------------
// Ein angeschlagener Ton wird in einen Puffer gemischt und am Stueck
// ausgegeben. Das blockiert fuer seine Dauer — vertretbar fuer eine
// Vorhoerhilfe, und ab Phase 5 loest die Tickschleife das ohnehin ab.
con PREVIEW_MS: int64 := 350;

// Playback-Modus umschalten. Die Modi sind keine Klangvarianten desselben
// Mixers, sondern verschiedene Backends — deshalb wird hier ein anderes
// Objekt gebaut und nicht ein Schalter gesetzt.
con MODE_PAULA: int64 := 0;
con MODE_8CH: int64 := 1;
con MODE_MIXER: int64 := 2;

fn SetPlaybackMode(mode: int64): void {
  g_mode := mode;
  if (mode == MODE_MIXER) {
    // So viele Stimmen wie der Song Spuren hat: ein 16-Spur-Modul auf acht
    // Stimmen zu spielen hiesse, die Haelfte stumm zu lassen.
    var voices: int64 := OM_MIX_CHANNELS;
    if (g_song != null) {
      var b0: TBlock := g_song.BlockAt(0);
      if (b0 != null) {
        if (b0.Tracks > voices) { voices := b0.Tracks; }
      }
    }
    g_backend := NewSoftwareMixerBackend(voices) as TPlaybackBackend;
  } else {
    if (mode == MODE_8CH) {
      g_backend := NewOctaMed8ChannelBackend() as TPlaybackBackend;
    } else {
      g_backend := NewPaula4ChannelBackend() as TPlaybackBackend;
    }
  }
  g_backend.Init(OM_MIX_RATE);
  // Der Modus gehoert zum Song, nicht nur zum Programm: FLAG_8CHANNEL steht
  // im Songheader und muss beim Sichern wieder dort landen.
  if (g_song != null) { g_song.EightChannel := (mode == MODE_8CH); }
  if (g_replay != null) { g_replay.Backend := g_backend; }
}

// ---- Abspielen -------------------------------------------------------------
// Der Timer ist die Uhr des Replays: er ruft je Tick die Engine, mischt einen
// Tick Audio und schiebt ihn in den ALSA-Strom. Der Schreibvorgang blockiert,
// bis das Geraet Platz hat — dadurch haelt sich das Ganze von selbst im Takt,
// ohne dass irgendwo eine Wartezeit gezaehlt wird.
//
// Der Zeichenteil folgt der gespielten Line: im Tracker schaut man beim Hoeren
// auf das Raster, ein stehender Cursor waere unbrauchbar.
fn OnReplayTick(sender: TControl): void {
  if (g_replay == null) { return; }
  if (!g_replay.Playing) { return; }
  if (g_backend == null) { return; }
  if (g_tick_buf == 0) { return; }
  if (g_audio == null) { return; }

  // So viele Ticks rendern, wie in den Geraetepuffer passen — nicht genau
  // einen je Timeraufruf. Der Timer ist ungenau (die Oberflaeche laeuft in
  // derselben Schleife); wer sich auf ihn verlaesst, laesst den Puffer
  // leerlaufen, und dann bricht der Ton nach dem ersten Block ab.
  var frames: int64 := g_replay.FramesPerTick(OM_MIX_RATE);
  if (frames < 1) { return; }

  // Vorlauf: so viel Ton haelt das Programm dem Geraet voraus. Das ist eine
  // Abwaegung, keine freie Wahl — zu wenig, und der Puffer laeuft leer,
  // sobald das Raster neu gezeichnet wird (gemessen: 15 Aussetzer je Sekunde
  // bei 40 ms); zu viel, und der Cursor laeuft der Musik davon. Sechs Ticks
  // muss ueber der laengsten gemessenen Zeichenpause liegen (263 ms), sonst
  // knackt es bei jeder. Zwanzig Ticks sind rund 400 ms.
  var vorlauf: int64 := frames * 30;


  // Die Obergrenze ist eine Notbremse gegen Endlosschleifen, keine Drossel:
  // sie muss ueber dem liegen, was eine Zeichenpause verbraucht. Mit acht
  // Runden (160 ms) lieferte das Programm bei 316-ms-Pausen weniger nach, als
  // verbraucht wurde — der Vorrat schrumpfte auf 56 ms und lief dann leer.
  var runden: int64 := 0;
  while (runden < 64) {
    if (g_audio.Delay() >= vorlauf) { runden := 64; }
    else {
      if (g_audio.Avail() < frames) { runden := 64; }
    else {
      if (!g_replay.DoTick()) { runden := 64; }
      else {
        // Kein Nullen des Puffers: RenderTick beschreibt JEDEN Frame
        // vollstaendig (beide Kanaele, je zwei Bytes). Das Vorabloeschen
        // waren 3528 einzelne Schreibzugriffe je Tick — reine Arbeit ohne
        // Wirkung, und sie fiel genau in die Zeit, die fuer den Nachschub
        // fehlte.
        g_backend.RenderTick(g_tick_buf, frames);
        g_audio.WriteFrames(g_tick_buf, frames);
        runden := runden + 1;

        // Das Bild folgt der gespielten Line, aber nur auf Tick 0: bei jedem
        // Tick neu zu zeichnen hiesse sechsmal je Line dasselbe Bild.
        if (g_replay.Tick == 1) {
          if (g_grid != null) {
            if (g_grid.Block != null) {
              g_grid.SetCursor(g_replay.Line, g_grid.CurTrack, g_grid.CurCol);
            }
          }
        }
        }
      }
    }
  }
}

fn ActPlaySong(sender: TControl): void {
  if (g_replay == null) { return; }
  // Mit leerem Geraetepuffer anfangen, sonst klebt der Rest des vorigen
  // Durchlaufs vorn am neuen.
  if (g_audio != null) { g_audio.Flush(); }
  g_replay.Attach(g_song, g_backend);
  g_replay.PlaySong();
}

fn ActPlayBlock(sender: TControl): void {
  if (g_replay == null) { return; }
  // Mit leerem Geraetepuffer anfangen, sonst klebt der Rest des vorigen
  // Durchlaufs vorn am neuen.
  if (g_audio != null) { g_audio.Flush(); }
  g_replay.Attach(g_song, g_backend);
  g_replay.PlayBlock(g_block_no);
}

fn ActStop(sender: TControl): void {
  if (g_replay == null) { return; }
  g_replay.Stop();
  // Was im Geraet steht, gehoert nicht mehr zum Stueck: ohne Verwerfen liefe
  // der Puffer nach dem Stopp noch hoerbar weiter.
  if (g_audio != null) { g_audio.Flush(); }
}

fn ActModePaula(sender: TControl): void { SetPlaybackMode(MODE_PAULA); }
fn ActMode8Ch(sender: TControl): void { SetPlaybackMode(MODE_8CH); }
fn ActModeMixer(sender: TControl): void { SetPlaybackMode(MODE_MIXER); }

fn PreviewNote(sender: TControl, note: int64, instr: int64): void {
  if (g_backend == null) { return; }
  if (g_audio == null) { return; }
  if (g_song == null) { return; }

  var ins: TInstrument := g_song.Instrument(instr);
  if (ins == null) { return; }
  if (ins.SampleData == 0) { return; }

  // Der Kanal folgt dem Track, auf dem getippt wird: im Paula-Modus hoert man
  // dadurch schon beim Eingeben, auf welcher Seite die Note spaeter liegt.
  var ch: int64 := 0;
  if (g_grid != null) { ch := g_grid.CurTrack; }

  var period: int64 := NotePeriod(note + ins.Transpose, ins.FineTune);
  g_backend.NoteOff(ch);
  g_backend.NoteOn(ch, ins, period, ins.Volume);

  if (g_pcm == 0) { return; }
  // Der Puffer wird vor jedem Ton geleert: RenderTick mischt nur dazu, was
  // die Stimmen liefern, und eine ausgelaufene Stimme wuerde sonst den
  // vorigen Ton stehen lassen.
  var i: int64 := 0;
  while (i < g_pcm_frames * 4) {
    poke8(g_pcm + i, 0);
    i := i + 1;
  }
  g_backend.RenderTick(g_pcm, g_pcm_frames);
  g_audio.PlayPCM(g_pcm, g_pcm_frames);
  g_backend.NoteOff(ch);
}

// Sample in das in der Instrumentliste gewaehlte Instrument laden. Das Format
// erkennt LoadSampleFile am Inhalt — die Endung sagt bei Amiga-Samples nichts.
fn ActLoadSample(sender: TControl): void {
  if (g_song == null) { return; }
  if (g_app == null) { return; }
  if (g_instr == null) { return; }

  var number: int64 := g_instr.Sel + 1;
  var ins: TInstrument := g_song.Instrument(number);
  if (ins == null) { return; }

  var dlg: TOpenDialog := NewOpenDialog();
  dlg.SetTitle("Load Sample");
  dlg.SetFilter("*");
  if (dlg.Execute(g_app)) {
    var path: TTextBuffer := new TTextBuffer();
    dlg.FullPath(path);
    if (LoadSampleFile(ins, path.AsPChar())) {
      if (g_editbar != null) { g_editbar.Invalidate(); }
    } else {
      PrintStrLn("Paula: Sample konnte nicht geladen werden");
    }
    path.Destroy();
  }
  dlg.Destroy();
}

// Block Properties: Name, Trackzahl, Linezahl. Danach muessen Grid und
// Blockliste neu gezeichnet werden — die Masse des Blocks stehen in beiden.
fn ActBlockProps(sender: TControl): void {
  if (g_song == null) { return; }
  if (g_app == null) { return; }
  var b: TBlock := g_song.BlockAt(g_block_no);
  if (b == null) { return; }
  if (ShowBlockProperties(g_app, b, g_block_no)) {
    if (g_grid != null) {
      g_grid.Attach(g_song, b);
    }
    FillLists();
  }
}

// Neuer Block mit den Massen des aktuellen — das ist beim Weiterschreiben
// fast immer gemeint, und aendern laesst er sich in den Block Properties.
fn ActNewBlock(sender: TControl): void {
  if (g_song == null) { return; }
  var cur: TBlock := g_song.BlockAt(g_block_no);
  var tracks: int64 := 4;
  var lines: int64 := 64;
  if (cur != null) {
    tracks := cur.Tracks;
    lines := cur.Lines;
  }
  var b: TBlock := NewBlock(tracks, lines);
  b.Name := "Block";
  g_block_no := g_song.AddBlock(b);
  g_song.AddSequenceEntry(g_block_no);
  if (g_grid != null) { g_grid.Attach(g_song, b); }
  if (g_info != null) { g_info.ShowBlock(g_block_no); }
  FillLists();
}

// Transponieren wirkt auf die Markierung, sonst auf die Cursorzelle — dieselbe
// Regel wie bei den Bereichsbefehlen im Edit-Menue.
fn ActTransposeUp(sender: TControl): void {
  if (g_grid != null) { g_grid.TransposeRange(1); }
}

fn ActTransposeDown(sender: TControl): void {
  if (g_grid != null) { g_grid.TransposeRange(-1); }
}

fn ActTransposeOctUp(sender: TControl): void {
  if (g_grid != null) { g_grid.TransposeRange(12); }
}

fn ActTransposeOctDown(sender: TControl): void {
  if (g_grid != null) { g_grid.TransposeRange(-12); }
}

// Teilen an der Cursorline: was darunter steht, wird ein eigener Block direkt
// hinter dem aktuellen.
fn ActSplitBlock(sender: TControl): void {
  if (g_song == null) { return; }
  if (g_grid == null) { return; }
  if (!g_song.SplitBlockAt(g_block_no, g_grid.CurLine)) { return; }
  g_grid.Attach(g_song, g_song.BlockAt(g_block_no));
  FillLists();
}

fn ActJoinBlock(sender: TControl): void {
  if (g_song == null) { return; }
  if (!g_song.JoinWithNext(g_block_no)) { return; }
  if (g_grid != null) { g_grid.Attach(g_song, g_song.BlockAt(g_block_no)); }
  FillLists();
}

fn ActSequence(sender: TControl): void {
  if (g_song == null) { return; }
  if (g_app == null) { return; }
  ShowSequenceWindow(g_app, g_song);
  FillLists();
}

// Klick in die Blockliste schaltet den Blockeditor um. Ohne das waere die
// Liste eine Anzeige und kein Bedienelement — und ein zweiter Block liesse
// sich gar nicht erreichen.
fn ActSelectBlock(sender: TControl): void {
  if (g_song == null) { return; }
  if (g_blocks == null) { return; }
  var no: int64 := g_blocks.Sel;
  var b: TBlock := g_song.BlockAt(no);
  if (b == null) { return; }
  g_block_no := no;
  if (g_grid != null) { g_grid.Attach(g_song, b); }
  if (g_info != null) { g_info.ShowBlock(no); }
}

// Klick in die Instrumentliste setzt das Eingabeinstrument — genau das
// erwartet man, wenn man vor dem Tippen ein Instrument auswaehlt.
fn ActSelectInstr(sender: TControl): void {
  if (g_instr == null) { return; }
  if (g_editbar == null) { return; }
  g_editbar.Instr := g_instr.Sel + 1;
  g_editbar.Invalidate();
}

// Modul laden. Ein fehlgeschlagener Ladeversuch laesst den bisherigen Song
// unangetastet — der halb geladene Zustand waere schlimmer als gar keiner.
fn ActLoadSong(sender: TControl): void {
  if (g_app == null) { return; }

  var dlg: TOpenDialog := NewOpenDialog();
  dlg.SetTitle("Load Song");
  dlg.SetFilter("*");
  if (dlg.Execute(g_app)) {
    var path: TTextBuffer := new TTextBuffer();
    dlg.FullPath(path);
    // Format am Inhalt erkennen, nicht an der Endung. MOD traegt seine
    // Kennung bei Byte 1080, MMD am Anfang — beide sagen es also selbst.
    var loaded: TSong := null;
    if (IsS3M(path.AsPChar())) { loaded := LoadS3M(path.AsPChar()); }
    else {
      if (IsMOD(path.AsPChar())) { loaded := LoadMOD(path.AsPChar()); }
      else { loaded := LoadMMD(path.AsPChar()); }
    }

    if (loaded == null) {
      PrintStrLn("Paula: kein lesbares Modul (MMD0/1/2, MOD oder S3M)");
    } else {
      // Der geladene Modus gehoert zum Song: FLAG_8CHANNEL entscheidet in
      // AdoptSong, mit welchem Backend das Stueck klingen soll.
      AdoptSong(loaded);
    }
    path.Destroy();
  }
  dlg.Destroy();
}

// Song im Editor bekanntmachen — nach Laden und nach New Song derselbe Weg.
fn AdoptSong(s: TSong): void {
  if (s == null) { return; }
  if (g_replay != null) { g_replay.Stop(); }
  g_song := s;
  g_block_no := 0;

  // Der Song sagt, wohin er gehoert: S3M in den Mixer, FLAG_8CHANNEL in den
  // 8-Kanal-Modus, alles andere auf die Paula.
  if (g_song.MixMode) { SetPlaybackMode(MODE_MIXER); }
  else {
    if (g_song.EightChannel) { SetPlaybackMode(MODE_8CH); }
    else { SetPlaybackMode(MODE_PAULA); }
  }

  if (g_replay != null) { g_replay.Attach(g_song, g_backend); }
  if (g_grid != null) { g_grid.Attach(g_song, g_song.BlockAt(0)); }
  if (g_info != null) {
    g_info.Attach(g_song);
    g_info.ShowBlock(0);
  }
  if (g_editbar != null) {
    g_editbar.Attach(g_song);
    g_editbar.Instr := 1;
  }
  FillLists();
}

// Leerer Song: ein Block, eine Sequence mit diesem Block, keine Instrumente.
// Ohne den Block haette der Editor nichts zu zeigen, ohne den Sequenzeintrag
// spielte Play Song ins Leere.
fn ActNewSong(sender: TControl): void {
  var s: TSong := NewSong("Untitled");
  var b: TBlock := NewBlock(4, 64);
  b.Name := "Block";
  s.AddBlock(b);
  s.AddSequenceEntry(0);
  AdoptSong(s);
}

// Sichern als MMD1. Geschrieben wird immer dieses Format, auch wenn das
// geladene Modul MMD0 oder MMD2 war: MMD0 kann Commands ueber 0F nicht
// darstellen, und alles, was hier entsteht, passt in MMD1.
fn ActSaveSong(sender: TControl): void {
  if (g_song == null) { return; }
  if (g_app == null) { return; }

  var dlg: TSaveDialog := NewSaveDialog();
  dlg.SetTitle("Save Song");
  dlg.SetFilter("*");
  dlg.SetDefaultExt(".med");
  dlg.SetFileName(g_song.Name);
  if (dlg.Execute(g_app)) {
    var path: TTextBuffer := new TTextBuffer();
    dlg.FullPath(path);
    if (!SaveMMD(g_song, path.AsPChar())) {
      PrintStrLn("Paula: Song konnte nicht gesichert werden");
    }
    path.Destroy();
  }
  dlg.Destroy();
}

fn ActInstrProps(sender: TControl): void {
  if (g_song == null) { return; }
  if (g_app == null) { return; }
  if (g_instr == null) { return; }
  var number: int64 := g_instr.Sel + 1;
  var ins: TInstrument := g_song.Instrument(number);
  if (ins == null) { return; }
  if (ShowInstrumentProperties(g_app, ins, number)) {
    FillLists();
    if (g_editbar != null) { g_editbar.Invalidate(); }
  }
}

fn ActMidiSetup(sender: TControl): void {
  if (g_app == null) { return; }
  if (g_midi == null) { return; }
  ShowMidiSetup(g_app, g_midi);
}

// ---- Edit-Menue ------------------------------------------------------------
// Ohne Markierung wirken die Befehle auf die Zelle unter dem Cursor. Das ist
// keine Notloesung, sondern die Erwartung: eine einzelne Zelle zu kopieren
// soll nicht erst eine Markierung verlangen.
fn ActCopyRange(sender: TControl): void {
  if (g_grid == null) { return; }
  g_clip := g_grid.CopySelection();
}

fn ActCutRange(sender: TControl): void {
  if (g_grid == null) { return; }
  g_clip := g_grid.CopySelection();
  g_grid.ClearRange();
}

fn ActPasteRange(sender: TControl): void {
  if (g_grid == null) { return; }
  if (g_clip == null) { return; }
  g_grid.PasteAt(g_clip);
}

fn ActClearRange(sender: TControl): void {
  if (g_grid == null) { return; }
  g_grid.ClearRange();
}

